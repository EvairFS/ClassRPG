import { Router } from "express";
import { prisma } from "./prisma"; // Ajuste o caminho do seu cliente Prisma

const router = Router();

router.post("/missions", async (req, res) => {
  try {
    const { 
      title, 
      description, 
      type, 
      difficulty, 
      xpReward, 
      monsterHp, 
      goldReward, 
      deadline,
      questions // Array enviado pelo front
    } = req.body;

    // Suposição: você pega o ID do professor autenticado pelo middleware de token
    const teacherId = req.user?.id; 

    const newMission = await prisma.mission.create({
      data: {
        title,
        description,
        type,
        difficulty,
        xp_reward: Number(xpReward),
        monster_hp: Number(monsterHp) || 100,
        gold_reward: Number(goldReward) || 0,
        deadline: new Date(deadline),
        teacher_id: teacherId,
        
        // ⚔️ Cria as perguntas vinculadas automaticamente usando a API do Prisma
        questions: {
          create: questions.map((q: any) => ({
            statement: q.text,          // Mapeia 'text' do front para 'statement' do banco
            options: q.options,
            correct_index: q.correctIndex, // Mapeia camelCase para snake_case do banco
            damage: q.damage || 25,
          })),
        },
      },
      include: {
        questions: true, // Retorna a missão com as perguntas inclusas
      },
    });

    return res.status(201).json({ data: newMission });
  } catch (error) {
    console.error(error);
    return res.status(400).json({ error: "Erro ao criar a missão. Verifique os campos." });
  }
});

export default router;